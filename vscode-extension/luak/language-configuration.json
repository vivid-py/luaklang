{
    "comments": {
        "lineComment": "#"
    },
    "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"" }
    ],
    "surroundingPairs": [
        ["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""]
    ],
    "indentationRules": {
        "increaseIndentPattern": "\\b(do|else)\\b",
        "decreaseIndentPattern": "\\b(end)\\b"
    }
}